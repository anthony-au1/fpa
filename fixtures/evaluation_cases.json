    "description": "A valid invoice pauses for approval and submits exactly once after approval.",
    "input": {
      "case_id": "FIN-001",
      "invoice_reference": "INV-001",
      "vendor": "Acme Supplies Pty Ltd",
      "amount": "1100",
      "currency": "AUD",
      "purchase_order_reference": "PO-1001"
    },
    "approval_actions": [
      {
        "decision": "APPROVE",
        "approver_id": "manager-1",
        "approver_role": "Cost Centre Manager",
        "idempotency_key": "fin-001-approval"
      }
    ],
    "expected_assertions": [
      "initial_status_waiting_for_approval",
      "no_decision_before_approval",
      "deterministic_controls_eligible",
      "approval_context_sanitized",
      "required_authority_identified",
      "approval_has_citations",
      "same_run_completed",
      "one_finance_decision",
      "submission_exactly_once",
      "audit_milestones_present",
      "policy_evidence_retrieved",
      "model_citations_were_retrieved",
      "current_authority_present"
    ]
  },
  {
